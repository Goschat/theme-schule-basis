{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"custom": false,
			"customGradient": false,
			"customDuotone": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "grund", "name": "Grund", "color": "#ffffff" },
				{ "slug": "flaeche", "name": "Fläche", "color": "#f6f4f0" },
				{ "slug": "text", "name": "Text", "color": "#1d1d1b" },
				{ "slug": "text-leise", "name": "Text leise", "color": "#4a4a48" },
				{ "slug": "leitfarbe", "name": "Leitfarbe", "color": "#1a5e8a" },
				{ "slug": "auf-leitfarbe", "name": "Text auf Leitfarbe", "color": "#ffffff" },
				{ "slug": "akzent", "name": "Akzent", "color": "#8a4b1a" },
				{ "slug": "rahmen", "name": "Rahmen", "color": "#767676" },
				{ "slug": "fokus", "name": "Fokus", "color": "#b45309" }
			]
		},
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"fluid": false,
			"dropCap": false,
			"fontFamilies": [
				{
					"slug": "schrift-text",
					"name": "Schrift Text",
					"fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
				},
				{
					"slug": "schrift-titel",
					"name": "Schrift Titel",
					"fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "klein", "name": "Klein", "size": "0.9375rem" },
				{ "slug": "normal", "name": "Normal", "size": "1.125rem" },
				{ "slug": "gross", "name": "Groß", "size": "1.375rem" },
				{ "slug": "xl", "name": "Sehr groß", "size": "1.75rem" },
				{ "slug": "xxl", "name": "Riesig", "size": "2.25rem" }
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [ "rem", "%", "vw" ],
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.5rem" },
				{ "slug": "30", "name": "S", "size": "1rem" },
				{ "slug": "40", "name": "M", "size": "1.5rem" },
				{ "slug": "50", "name": "L", "size": "2.5rem" },
				{ "slug": "60", "name": "XL", "size": "4rem" }
			]
		},
		"layout": {
			"contentSize": "42rem",
			"wideSize": "72rem"
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--grund)",
			"text": "var(--wp--preset--color--text)"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--30)",
			"padding": {
				"left": "var(--wp--preset--spacing--30)",
				"right": "var(--wp--preset--spacing--30)"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--schrift-text)",
			"fontSize": "var(--wp--preset--font-size--normal)",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--leitfarbe)" },
				"typography": { "textDecoration": "underline" },
				":hover": { "typography": { "textDecoration": "none" } }
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--text)" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--schrift-titel)",
					"fontWeight": "700",
					"lineHeight": "1.25"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xxl)" } },
			"h2": {
				"color": { "text": "var(--wp--preset--color--leitfarbe)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--xl)" }
			},
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--gross)" } },
			"button": {
				"color": {
					"background": "var(--wp--preset--color--leitfarbe)",
					"text": "var(--wp--preset--color--auf-leitfarbe)"
				},
				"border": { "radius": "0.375rem" },
				"typography": { "fontWeight": "700" },
				":hover": { "color": { "background": "var(--wp--preset--color--text)" } }
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": { "fontSize": "var(--wp--preset--font-size--normal)" }
			},
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--schrift-titel)",
					"fontSize": "var(--wp--preset--font-size--gross)",
					"fontWeight": "700"
				}
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Kopfbereich", "area": "header" },
		{ "name": "footer", "title": "Fußbereich", "area": "footer" }
	]
}
